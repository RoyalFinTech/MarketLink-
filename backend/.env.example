NODE_ENV=development
PORT=4000
API_BASE_URL=https://marketlink-gambia.onrender.com
CORS_ORIGIN=https://royalfintech.github.io
DATABASE_URL=postgresql://postgres.nsglfunkdnpchoqqzmcc:YOUR_DATABASE_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_SSL=true
JWT_ACCESS_SECRET=replace_with_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SUPABASE_URL=https://nsglfunkdnpchoqqzmcc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=marketlink-uploads
SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
OTP_EXPIRY_MINUTES=5
OTP_DEV_MODE=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=marketlinkgambia@gmail.com
# Modem Pay hosted merchant integration (keep all credentials on the backend only)
MODEM_PAY_API_KEY=
MODEM_PAY_API_MODE=merchant
MODEM_PAY_BASE_URL=https://api.modempay.com/v1
MODEM_PAY_WEBHOOK_SECRET=
# SHA-256 hash of the API secret, only for Modem Pay per-payment callback signing
MODEM_PAY_SECRET_HASH=
# Optional per-payment callback URL; the global dashboard webhook can be used instead
MODEM_PAY_CALLBACK_URL=
MODEM_PAY_RETURN_URL=https://marketlink-gambia-frontend.onrender.com/
MODEM_PAY_CANCEL_URL=https://marketlink-gambia-frontend.onrender.com/
# Backward-compatible name used in Modem Pay's published Node webhook guide
MODEM_WEBHOOK_SECRET=
# Enable only after Modem Pay approves the account for H2H access
MODEM_PAY_H2H_APPROVED=false

# Manual COD cash remittance destinations shown to riders (official company accounts only)
MARKETLINK_COD_WAVE_ACCOUNT_NUMBER=
MARKETLINK_COD_WAVE_ACCOUNT_NAME=
MARKETLINK_COD_AFRIMONEY_ACCOUNT_NUMBER=
MARKETLINK_COD_AFRIMONEY_ACCOUNT_NAME=

# Reserved for future direct provider integrations; not used by the current manual COD receipt workflow
WAVE_API_KEY=
AFRIMONEY_API_KEY=
STRIPE_SECRET_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
GOOGLE_MAPS_API_KEY=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
